# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_WORKERS=4
SERVER_MAX_CONCURRENT_REQUESTS=2000

# AWS Bedrock Configuration
AWS_REGION=us-east-1
AWS_PROFILE=default
# Alternative: API Key authentication
# AWS_BEDROCK_API_KEY=your_api_key_here

BEDROCK_DEFAULT_MODEL=anthropic.claude-sonnet-4-20250514
BEDROCK_MODEL_CLAUDE=anthropic.claude-sonnet-4-20250514
BEDROCK_MODEL_LLAMA=meta.llama-3-1-405b-instruct
BEDROCK_MODEL_MISTRAL=mistral.mistral-large-2407
BEDROCK_AUTH_METHOD=iam
BEDROCK_TIMEOUT=60
BEDROCK_MAX_RETRIES=3

# MCP Configuration
MCP_TIMEOUT=30
MCP_MAX_RETRIES=2
# MCP remote tool endpoint
# MCP_REMOTE_URL=https://example.com/mcp

# Agent Configuration
AGENT_MAX_ITERATIONS=10
AGENT_TOOL_TIMEOUT=30
AGENT_REFLECTION_ENABLED=true

# ag-ui Protocol Configuration
AGUI_BUFFER_SIZE=8192
AGUI_HEARTBEAT_INTERVAL=15

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
